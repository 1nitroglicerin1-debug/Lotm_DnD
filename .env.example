# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=664506059

# Путь к файлу базы данных
DB_PATH=data/bot.db

# Путь к SQLite-хранилищу FSM (состояния форм переживают рестарт). Пусто — рядом с DB_PATH
FSM_DB_PATH=

# Настройки ИИ-Мастера (proxyapi.ru / любой OpenAI-совместимый API)
# Ключ из личного кабинета proxyapi.ru
LLM_API_KEY=
LLM_API_URL=https://api.proxyapi.ru/v1/chat/completions
LLM_MODEL=deepseek/deepseek-v4.1-flash-1017

# Публичный HTTPS-адрес веб-клиента (Mini App). Без него кнопка веб-терминала не показывается.
# Проще всего: облачный туннель (cloudflared / ngrok) или Caddy на VPS
WEBAPP_URL=

# Ссылка на оплату картой через Tribute (необязательно)
TRIBUTE_LINK=
