# Токен от @BotFather
BOT_TOKEN=123456789:AAAA-your-token-here

# Telegram ID администраторов через запятую (узнать свой ID: @userinfobot)
ADMIN_IDS=664506059

# Путь к файлу базы данных
DB_PATH=data/bot.db

# Путь к SQLite-хранилищу FSM (состояния форм переживают рестарт). Пусто — рядом с DB_PATH
FSM_DB_PATH=

# Настройки ИИ-Мастера (proxyapi.ru / OpenAI-совместимый API)
# Ключ из личного кабинета proxyapi.ru (или DeepSeek/OpenRouter — тогда поменяй URL и модель)
LLM_API_KEY=
LLM_API_URL=https://api.proxyapi.ru/openai/v1/chat/completions
# ВАЖНО: модель должна быть из списка доступных на прокси. deepseek/deepseek-v4-flash-1017 НЕ поддерживается -> "Model not supported"
LLM_MODEL=gpt-5.4-mini

# Ссылка на оплату картой через Tribute (необязательно)
TRIBUTE_LINK=
